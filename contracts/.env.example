# TapeOut processor factory on X Layer mainnet (chain 196), from TAP-10 "Deployments":
# https://github.com/TapeOutProtocol/TAPs/blob/main/TAPs/TAP-10.md
# Setting it enables the fork test in test/fork/TapeOutSpike.fork.t.sol.
TAPEOUT_FACTORY_XLAYER=0x1f09DAeFA827f02CBb40967cc91b259763760761

# Optional: foundry.toml [rpc_endpoints] alias the fork test uses (default xlayer_mainnet).
# TAPEOUT_FORK_RPC_ALIAS=xlayer_mainnet

# --- Full-stack mainnet deploy (script/deploy-xlayer-stack.sh, docs/TAPEOUT_MAINNET_RUNBOOK.md) ---
DEPLOYER_ADDRESS=0x9f718b338Ccc69B6AC211Dc8239548E43095813a
# Public and permanent: the processor's on-chain name, symbol and story.
TAPEOUT_CPU_NAME=
TAPEOUT_CPU_SYMBOL=
TAPEOUT_CPU_STORY=
# BEM per gate others pay to mint from the processor (8 decimals). Set at creation.
# TAPEOUT_MINT_PRICE=0
# Live price sources for the mock oracle (script/fetch-mock-prices.sh).
OKX_TICKER_API_URL=https://www.okx.com/api/v5/market/ticker
YAHOO_CHART_API_URL=https://query1.finance.yahoo.com/v8/finance/chart
# BEM bridge from BNB Chain (script/bridge-bem.sh). The adapter is BEM's LayerZero OFT peer on
# BNB Chain for eid 30274 (X Layer); read back with peers(30274) on the X Layer BEM.
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org
BEM_BSC_ADAPTER=0xa84b8d3893de6e9922f2b29be1e1b115845f5e72
BEM_XLAYER_EID=30274
