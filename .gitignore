# ---------- Secrets & keys (never commit) ----------
.env
.env.*
!.env.example

# Solana keypairs are raw private keys in plaintext JSON.
# Explicit devnet test keys generated by scripts/zeta-vault-test.ts:
drift-owner-keypair.json
drift-delegate-keypair.json
**/drift-owner-keypair.json
**/drift-delegate-keypair.json
# Catch-all safety net — deliberately broad. If you ever need to commit a
# file matching this (a test fixture, say), use `git add -f`.
**/*keypair*.json
id.json
*.pem

# ---------- Rust / Anchor build output ----------
# target/ is ~1.5GB here. It also contains target/deploy/*-keypair.json,
# the keypair that defines the program ID — see note in CLAUDE.md.
target/
.anchor/
test-ledger/

# ---------- Node ----------
node_modules/
dist/
build/
*.tsbuildinfo

# ---------- Next.js (frontend, once scaffolded) ----------
.next/
out/
.vercel/

# ---------- Vendored reference clone ----------
# backend/execution-runtime/drift-protocol-v2 is a 61MB clone of the public
# repo github.com/drift-labs/protocol-v2, with its own .git directory. Git
# cannot track it cleanly as a plain directory — committing it would record a
# broken gitlink. Re-clone it locally if you need it, or convert it to a real
# submodule if it must be pinned.
backend/execution-runtime/drift-protocol-v2/

# ---------- Logs & misc ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
.idea/
*.swp
.gstack/
frontend/public/vx.mp4
