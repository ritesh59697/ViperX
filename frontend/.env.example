# ViperX Public Environment Variables
NEXT_PUBLIC_RUNTIME_PUBKEY=2EaDP5DHuPsaAZiSuXUvRtCJFStRFwCpamXapUcvWGLq
NEXT_PUBLIC_BASE_REGISTRY_ADDRESS=0xA256D01Ca6e89c5B6bDf34F3dd68eBfF47f2C7ee
NEXT_PUBLIC_LEADERBOARD_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# OKX X Layer — ViperX deployment
#
# lib/xlayer.ts reads these and throws if any is missing. There are no fallback
# defaults on purpose: inlined copies of these addresses went stale on the last
# redeploy, and a wrong address fails more confusingly than an absent one.
#
# Testnet and mainnet differ only in these values. The testnet block is live; the
# mainnet block is filled from contracts/deployments/xlayer-196.env after
# contracts/script/deploy-xlayer-stack.sh runs. Use one block at a time.
# ---------------------------------------------------------------------------

# Testnet (chain 1952), live as of 2026-11-11. Its gate is the earlier single-circuit
# testnet gate, not a TapeOut circuit (TapeOut exists only on mainnet).
NEXT_PUBLIC_XLAYER_CHAIN_ID=1952
NEXT_PUBLIC_XLAYER_NETWORK_NAME=OKX X Layer Testnet
NEXT_PUBLIC_XLAYER_RPC_URL=https://testrpc.xlayer.tech
NEXT_PUBLIC_XLAYER_EXPLORER=https://www.oklink.com/xlayer-test
NEXT_PUBLIC_XLAYER_TESTNET=true
NEXT_PUBLIC_XLAYER_VIPER_VAULT=0x347C8ebB8e88B2A556fb9d951469238FE6628501
NEXT_PUBLIC_XLAYER_POSITION_ROUTER=0x8C58098B382b982fA78214dB8a10b0374c586932
NEXT_PUBLIC_XLAYER_CIRCUIT_GUARDIAN=0x85F625e8D773f645217298808d9a8edf6D821198
NEXT_PUBLIC_XLAYER_TAPEOUT_PROCESSOR=0x5474874Eb3B6945EFEcBeB4041c1b39f4B3918Ff
NEXT_PUBLIC_XLAYER_PRICE_ADAPTER=0xcce8dbdde8a997217CFf51c4A2076f3B9Eb44b70
NEXT_PUBLIC_XLAYER_USDC=0x6046c644ea622fBa3043F35d979BAEE83339cfEe
NEXT_PUBLIC_XLAYER_ORACLE=0xA256D01Ca6e89c5B6bDf34F3dd68eBfF47f2C7ee
NEXT_PUBLIC_XLAYER_CIRCUIT_ID=101

# Mainnet (chain 196) — the four TapeOut risk circuits. Live on www.viperx.site since 2026-11-16.
# NEXT_PUBLIC_XLAYER_CHAIN_ID=196
# NEXT_PUBLIC_XLAYER_NETWORK_NAME=OKX X Layer
# NEXT_PUBLIC_XLAYER_RPC_URL=https://rpc.xlayer.tech
# NEXT_PUBLIC_XLAYER_EXPLORER=https://www.oklink.com/xlayer
# NEXT_PUBLIC_XLAYER_TESTNET=false
